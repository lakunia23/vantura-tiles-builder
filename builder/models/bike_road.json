{
  "speed": [
    {
      "if": "true",
      "limit_to": "25"
    },
    {
      "if": "!bike_access && foot_access",
      "multiply_by": "0.3"
    },
    {
      "if": "surface == COBBLESTONE",
      "multiply_by": "0.5"
    }
  ],
  "priority": [
    {
      "if": "road_class == MOTORWAY || road_class == TRUNK",
      "multiply_by": "0"
    },
    {
      "if": "road_class == STEPS",
      "multiply_by": "0"
    },
    {
      "if": "!bike_access && (road_class == PATH || road_class == TRACK || road_class == BRIDLEWAY)",
      "multiply_by": "0"
    },
    {
      "if": "!bike_access && foot_access",
      "multiply_by": "0.08"
    },
    {
      "if": "!bike_access && !foot_access",
      "multiply_by": "0"
    },
    {
      "if": "(surface == UNPAVED || surface == COMPACTED || surface == FINE_GRAVEL || surface == GRAVEL || surface == GROUND || surface == DIRT || surface == GRASS || surface == SAND || surface == WOOD || surface == OTHER)",
      "multiply_by": "0"
    },
    {
      "if": "(road_class == TRACK || road_class == PATH) && surface == MISSING",
      "multiply_by": "0"
    },
    {
      "if": "surface == COBBLESTONE",
      "multiply_by": "0.15"
    },
    {
      "if": "surface == PAVING_STONES",
      "multiply_by": "0.6"
    },
    {
      "if": "smoothness == BAD || smoothness == VERY_BAD || smoothness == HORRIBLE || smoothness == VERY_HORRIBLE || smoothness == IMPASSABLE",
      "multiply_by": "0.1"
    },
    {
      "if": "road_class == PRIMARY",
      "multiply_by": "0.35"
    },
    {
      "if": "road_class == SECONDARY",
      "multiply_by": "0.75"
    },
    {
      "if": "road_class == CYCLEWAY",
      "multiply_by": "1.4"
    },
    {
      "if": "road_class == FOOTWAY || road_class == PEDESTRIAN",
      "multiply_by": "0.4"
    }
  ]
}