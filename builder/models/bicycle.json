{
  "speed": [
    {
      "if": "true",
      "limit_to": "18"
    },
    {
      "if": "!bike_access && foot_access",
      "multiply_by": "0.3"
    },
    {
      "if": "surface == SAND",
      "multiply_by": "0.4"
    }
  ],
  "priority": [
    {
      "if": "road_class == MOTORWAY || road_class == TRUNK",
      "multiply_by": "0"
    },
    {
      "if": "road_class == STEPS",
      "multiply_by": "0"
    },
    {
      "if": "!bike_access && (road_class == PATH || road_class == TRACK || road_class == BRIDLEWAY)",
      "multiply_by": "0"
    },
    {
      "if": "!bike_access && foot_access",
      "multiply_by": "0.08"
    },
    {
      "if": "!bike_access && !foot_access",
      "multiply_by": "0"
    },
    {
      "if": "road_class == CYCLEWAY",
      "multiply_by": "1.5"
    },
    {
      "if": "bike_network != MISSING",
      "multiply_by": "1.3"
    },
    {
      "if": "surface == SAND || surface == GRASS",
      "multiply_by": "0.2"
    },
    {
      "if": "surface == COBBLESTONE",
      "multiply_by": "0.4"
    },
    {
      "if": "road_class == PRIMARY",
      "multiply_by": "0.25"
    },
    {
      "if": "road_class == SECONDARY",
      "multiply_by": "0.6"
    },
    {
      "if": "road_class == FOOTWAY || road_class == PEDESTRIAN",
      "multiply_by": "0.4"
    },
    {
      "if": "(road_class == TRACK || road_class == PATH) && surface == MISSING",
      "multiply_by": "0.5"
    }
  ]
}