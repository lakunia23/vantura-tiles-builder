{
  "speed": [
    {
      "if": "true",
      "limit_to": "5"
    }
  ],
  "priority": [
    {
      "if": "road_class == MOTORWAY || road_class == TRUNK",
      "multiply_by": "0"
    },
    {
      "if": "!foot_access",
      "multiply_by": "0"
    },
    {
      "if": "(surface == GROUND || surface == DIRT || surface == GRASS || surface == SAND)",
      "multiply_by": "0.15"
    },
    {
      "if": "(surface == UNPAVED || surface == GRAVEL || surface == OTHER)",
      "multiply_by": "0.5"
    },
    {
      "if": "(road_class == TRACK || road_class == PATH) && surface == MISSING",
      "multiply_by": "0.35"
    },
    {
      "if": "road_class == PEDESTRIAN || road_class == FOOTWAY || road_class == LIVING_STREET",
      "multiply_by": "1.4"
    },
    {
      "if": "road_class == PRIMARY",
      "multiply_by": "0.3"
    },
    {
      "if": "road_class == SECONDARY",
      "multiply_by": "0.6"
    }
  ]
}