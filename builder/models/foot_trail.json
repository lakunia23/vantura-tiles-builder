{
  "speed": [
    {
      "if": "true",
      "limit_to": "4.5"
    }
  ],
  "priority": [
    {
      "if": "road_class == MOTORWAY || road_class == TRUNK",
      "multiply_by": "0"
    },
    {
      "if": "!foot_access",
      "multiply_by": "0"
    },
    {
      "if": "road_class == PATH || road_class == TRACK || road_class == BRIDLEWAY",
      "multiply_by": "1.4"
    },
    {
      "if": "(surface == GROUND || surface == DIRT || surface == GRASS || surface == COMPACTED || surface == FINE_GRAVEL || surface == GRAVEL)",
      "multiply_by": "1.15"
    },
    {
      "if": "foot_network != MISSING",
      "multiply_by": "1.3"
    },
    {
      "if": "(surface == ASPHALT || surface == CONCRETE || surface == PAVING_STONES)",
      "multiply_by": "0.8"
    },
    {
      "if": "road_class == PRIMARY",
      "multiply_by": "0.1"
    },
    {
      "if": "road_class == SECONDARY",
      "multiply_by": "0.3"
    },
    {
      "if": "road_class == TERTIARY",
      "multiply_by": "0.55"
    },
    {
      "if": "road_class == CYCLEWAY",
      "multiply_by": "0.6"
    }
  ]
}