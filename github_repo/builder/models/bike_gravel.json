{
  "speed": [
    {
      "if": "true",
      "limit_to": "20"
    },
    {
      "if": "!bike_access && foot_access",
      "multiply_by": "0.3"
    },
    {
      "if": "surface == SAND",
      "multiply_by": "0.4"
    }
  ],
  "priority": [
    {
      "if": "road_class == MOTORWAY || road_class == TRUNK",
      "multiply_by": "0"
    },
    {
      "if": "road_class == STEPS",
      "multiply_by": "0"
    },
    {
      "if": "!bike_access && (road_class == PATH || road_class == TRACK || road_class == BRIDLEWAY)",
      "multiply_by": "0"
    },
    {
      "if": "!bike_access && foot_access",
      "multiply_by": "0.08"
    },
    {
      "if": "!bike_access && !foot_access",
      "multiply_by": "0"
    },
    {
      "if": "road_class == STEPS",
      "multiply_by": "0"
    },
    {
      "if": "(surface == COMPACTED || surface == FINE_GRAVEL || surface == GRAVEL)",
      "multiply_by": "1.5"
    },
    {
      "if": "road_class == TRACK && (track_type == GRADE1 || track_type == GRADE2 || track_type == GRADE3)",
      "multiply_by": "1.3"
    },
    {
      "if": "surface == SAND",
      "multiply_by": "0.15"
    },
    {
      "if": "surface == GRASS || track_type == GRADE5",
      "multiply_by": "0.4"
    },
    {
      "if": "road_class == PRIMARY",
      "multiply_by": "0.2"
    },
    {
      "if": "road_class == SECONDARY",
      "multiply_by": "0.5"
    },
    {
      "if": "road_class == FOOTWAY || road_class == PEDESTRIAN",
      "multiply_by": "0.4"
    }
  ]
}