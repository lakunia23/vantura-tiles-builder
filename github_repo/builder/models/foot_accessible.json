{
  "speed": [
    {
      "if": "true",
      "limit_to": "4"
    }
  ],
  "priority": [
    {
      "if": "road_class == MOTORWAY || road_class == TRUNK",
      "multiply_by": "0"
    },
    {
      "if": "!foot_access",
      "multiply_by": "0"
    },
    {
      "if": "road_class == STEPS",
      "multiply_by": "0"
    },
    {
      "if": "(surface == GROUND || surface == DIRT || surface == GRASS || surface == SAND || surface == GRAVEL || surface == UNPAVED || surface == WOOD || surface == OTHER || surface == COBBLESTONE)",
      "multiply_by": "0"
    },
    {
      "if": "max_slope > 10 || max_slope < -10",
      "multiply_by": "0"
    },
    {
      "if": "max_slope > 6 || max_slope < -6",
      "multiply_by": "0.3"
    },
    {
      "if": "smoothness == BAD || smoothness == VERY_BAD || smoothness == HORRIBLE || smoothness == VERY_HORRIBLE || smoothness == IMPASSABLE",
      "multiply_by": "0"
    },
    {
      "if": "(surface == COMPACTED || surface == FINE_GRAVEL)",
      "multiply_by": "0.5"
    },
    {
      "if": "(road_class == TRACK || road_class == PATH) && surface == MISSING",
      "multiply_by": "0"
    },
    {
      "if": "road_class == PEDESTRIAN || road_class == FOOTWAY || road_class == LIVING_STREET",
      "multiply_by": "1.4"
    },
    {
      "if": "road_class == PRIMARY || road_class == SECONDARY",
      "multiply_by": "0.4"
    }
  ]
}